MEDIA_GEN_HOST=0.0.0.0
MEDIA_GEN_PORT=8003
MEDIA_GEN_BASE_URL=http://localhost:8003
MEDIA_OUTPUT_DIR=output
MEDIA_GEN_DEVICE=

# Local weights root (see docs/user-guide/model-download.md)
LOCAL_MODELS_ROOT=

# Image: qwen (default, local Qwen-Image) | sd (Stable Diffusion)
IMAGE_BACKEND=qwen
IMAGE_MODEL=
# Alias when IMAGE_BACKEND=sd (or override IMAGE_MODEL)
SD_MODEL=

# Voice: qwen (default, local Qwen3-TTS) | edge (edge-tts)
VOICE_BACKEND=qwen
TTS_MODEL=
TTS_SPEAKER=
TTS_LANGUAGE=Chinese
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ASR: qwen (default, local Qwen3-ASR); override ASR_MODEL path or HF id
ASR_BACKEND=qwen
ASR_MODEL=
ASR_LANGUAGE=

COGVIDEOX_MODEL=THUDM/CogVideoX-2b
MEDIA_VIDEO_FORCE_LOCAL=
