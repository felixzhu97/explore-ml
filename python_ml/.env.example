# Explore ML — one process, one port. Copy to python_ml/.env (never commit it).

# Server
HOST=0.0.0.0
PORT=8000
# Absolute base for asset URLs the media modules return (defaults to http://localhost:$PORT)
# BASE_URL=
# Comma-separated subset of: recommendation,vision,rag,image_playground,speech,video
# EXPLORE_MODULES=

# Local models root — download guide: docs/user-guide/model-download.md
# LOCAL_MODELS_ROOT=

# --- Recommendation ---
DATABASE_URL=postgresql://chat:chat123@localhost:5433/chat
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CASSANDRA_CONTACT_POINTS=localhost:9042
CASSANDRA_KEYSPACE=chat
CASSANDRA_LOCAL_DC=datacenter1

# --- Vision ---
VISION_TOP_K=10
# VISION_MODEL_PATH=/path/to/resnet50-ft/model.pt
# VISION_LABELS_PATH=/path/to/resnet50-ft/labels.json
VISION_REQUEST_TIMEOUT=15.0
VISION_MAX_IMAGE_SIZE=800
VISION_MODERATION_ENABLED=true
VISION_MODERATION_THRESHOLD=0.15
VISION_NSFW_ENABLED=true
VISION_NSFW_THRESHOLD=0.35
VISION_MAX_VIDEO_FRAMES=30
VISION_VIDEO_FRAME_INTERVAL_SEC=2.0

# --- RAG ---
# UPLOADS_DIR=
# QDRANT_URL=
# Local on-disk Qdrant (no Docker). Used when QDRANT_URL is empty.
# QDRANT_PATH=
QDRANT_TIMEOUT=30
QDRANT_VECTOR_SIZE=768
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=ollama
LLM_MODEL=qwen3-coder:30b
LLM_TIMEOUT=120
OPENAI_LLM_MODEL=gpt-4-turbo-preview
CHUNK_SIZE=256
CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
RAG_TIMEOUT=30000
CACHE_TTL=3600
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
CRAWLER_TIMEOUT=30
CRAWLER_MAX_DEPTH=2
# Content API base URL for posts / comments sync
CONTENT_API_URL=http://localhost:3000
# Rerank via local Qwen3-Reranker HTTP serve (default on; skipped when unreachable)
RERANK_ENABLED=true
RERANK_URL=http://127.0.0.1:8091
# RERANK_MODEL=
RERANK_TIMEOUT=30

# --- Image Playground ---
# IMAGE_PLAYGROUND_OUTPUT_DIR=
# IMAGE_PLAYGROUND_DEVICE=
IMAGE_BACKEND=qwen
# IMAGE_MODEL=
# SD_MODEL=
# IMAGE_LORA_PATH=
IMAGE_LORA_SCALE=1.0

# --- Speech ---
# SPEECH_OUTPUT_DIR=
# SPEECH_DEVICE=
VOICE_BACKEND=qwen
# TTS_MODEL=
# TTS_SPEAKER=
TTS_LANGUAGE=Chinese
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
ASR_BACKEND=qwen
# ASR_MODEL=
# ASR_LANGUAGE=
ASR_STREAM_PARTIAL_INTERVAL_SEC=1.0
ASR_STREAM_MIN_PARTIAL_BYTES=32000

# --- Video ---
# VIDEO_OUTPUT_DIR=
# VIDEO_DEVICE=
COGVIDEOX_MODEL=THUDM/CogVideoX-2b
# VIDEO_FORCE_LOCAL=
