@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Level 1] Explore ML - System Context

Person(engineer, "Platform engineer", "Local boot, model test, fine-tuning")
System(explore_ml, "Explore ML", "One Python FastAPI loopback app on :8000 with six modules (recommendation, vision, RAG, image_playground, speech, video) plus the Angular Model Test UI with D3 charts")
System_Ext(sibling_api, "Sibling Explore API", "Spring (or other); calls http://localhost:8000 over loopback")
System_Ext(vector_db, "Qdrant", "RAG vectors; embedded on disk unless QDRANT_URL is set")
System_Ext(llm, "Ollama / OpenAI", "RAG embeddings and answers")
System_Ext(reranker, "Rerank sidecar", "Optional HTTP reranker (RERANK_URL)")
System_Ext(content_api, "Content API", "Posts and comments for RAG sync (CONTENT_API_URL)")
System_Ext(rec_stores, "Postgres / Redis / Cassandra", "Recommendation features, vectors, Celery broker")
System_Ext(weights, "Local model weights", "LOCAL_MODELS_ROOT (default ~/Codes/models)")
System_Ext(hub, "Hugging Face Hub", "Model downloads (HF_ENDPOINT) and training jobs")

Rel(engineer, explore_ml, "Start / health / model test")
Rel(sibling_api, explore_ml, "HTTP loopback", "optional")
Rel(explore_ml, vector_db, "Stores and searches chunks")
Rel(explore_ml, llm, "Embeds and generates")
Rel(explore_ml, reranker, "Rescores candidates", "optional")
Rel(explore_ml, content_api, "Reads posts / comments")
Rel(explore_ml, rec_stores, "Reads features, writes suggestions")
Rel(explore_ml, weights, "Loads checkpoints")
Rel(explore_ml, hub, "Downloads models")

SHOW_LEGEND()
@enduml
