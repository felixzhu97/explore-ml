@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Level 1] Explore ML - System Context

Person(engineer, "Platform engineer", "Local boot and integration")
System(explore_ml, "Explore ML", "Python FastAPI loopback helpers: recommendation, vision, RAG, image-playground, speech, video")
System_Ext(sibling_api, "Sibling Explore API", "Spring (or other); consumes helpers over loopback")
System_Ext(other_api, "Other Explore API", "Optional consumer")

Rel(engineer, explore_ml, "Start / health / model test")
Rel(sibling_api, explore_ml, "HTTP loopback", "optional")
Rel(other_api, explore_ml, "HTTP loopback", "optional")

SHOW_LEGEND()
@enduml
