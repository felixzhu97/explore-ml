@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_container", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Level 2] Explore ML - Container Diagram

Person(engineer, "Platform engineer", "Local")
System_Ext(sibling_api, "Sibling Explore API", "Product API boundary")

System_Boundary(ml, "Explore ML") {
  Container(ui, "Model Test UI", "Angular 22, NG-ZORRO, Tailwind, d3", "ui/ :4200 (ng serve)")
  Container(proxy, "Service proxy", "ng serve proxy", "ui/proxy.conf.mjs + shared/proxy.ts; /svc/<id> -> helper, override with <ID>_URL")
  Container(rec, "Recommendation", "FastAPI", "python_ml/recommendation :8000; rank + recall")
  Container(vision, "Vision", "FastAPI", "python_ml/vision :8001; labels + moderation")
  Container(rag, "RAG", "FastAPI", "python_ml/rag :8002; documents, query, sync")
  Container(ip, "Image Playground", "FastAPI", "python_ml/image-playground :8003; image jobs")
  Container(sp, "Speech", "FastAPI", "python_ml/speech :8004; TTS + ASR")
  Container(vd, "Video", "FastAPI", "python_ml/video :8005; video jobs")
  ContainerDb(fixtures, "Fixture data", "JSONL", "data/finetune/ for training/ scripts")
}

ContainerDb_Ext(qdrant, "Qdrant", "Vector DB", "Embedded at python_ml/rag/data/qdrant or QDRANT_URL")
Container_Ext(llm, "Ollama / OpenAI", "HTTP", "Embeddings + chat")
Container_Ext(content_api, "Content API", "HTTP", "DATABASE_URL /posts, /comments")
ContainerDb_Ext(rec_stores, "Postgres / Redis / Cassandra", "Stores", "Recommendation features and vectors")

Rel(engineer, ui, "Module pages", "Browser")
Rel(engineer, rag, "uvicorn / pytest", "every helper")
Rel(ui, proxy, "/svc/<id>", "same origin")
Rel(proxy, rec, "/svc/recommendation", "HTTP loopback")
Rel(proxy, vision, "/svc/vision", "HTTP loopback")
Rel(proxy, rag, "/svc/rag", "HTTP + SSE loopback")
Rel(proxy, ip, "/svc/image", "HTTP loopback")
Rel(proxy, sp, "/svc/speech", "HTTP + WS loopback")
Rel(proxy, vd, "/svc/video", "HTTP loopback")
Rel(sibling_api, rec, "HTTP", "optional")
Rel(sibling_api, vision, "HTTP", "optional")
Rel(sibling_api, rag, "HTTP", "optional")
Rel(sibling_api, ip, "HTTP", "optional")
Rel(sibling_api, sp, "HTTP", "optional")
Rel(sibling_api, vd, "HTTP", "optional")
Rel(rag, qdrant, "Upsert / search")
Rel(rag, llm, "Embed / answer")
Rel(rag, content_api, "Sync")
Rel(rec, rec_stores, "Features / vectors")
Rel(engineer, fixtures, "training/ --data")

SHOW_LEGEND()
@enduml
