@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("component", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Level 3] Explore ML - Component Diagram (single-service template)

Container_Boundary(svc, "python_ml/<name>") {
  Component(api, "controller/", "FastAPI routers", "HTTP + DTOs")
  Component(service, "service/", "orchestration", "No piled-up business rules")
  Component(domain, "domain/", "models / rules", "No external libraries")
  Component(infra, "infra/", "models / stores / ETL", "torch, redis, qdrant, httpx")
  Component(config, "config.py", "env", "ports / paths")
}

Rel(api, service, "calls")
Rel(service, domain, "calls")
Rel(service, infra, "calls")
Rel(infra, domain, "implements")
Rel(api, config, "reads")
Rel(service, config, "reads")

SHOW_LEGEND()
@enduml
