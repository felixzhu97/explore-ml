@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("node", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Deployment] Explore ML - 本地开发

Deployment_Node(dev_machine, "开发机", "macOS / Linux") {
  Deployment_Node(py_svcs, "python_ml（venv）", "") {
    Container(rec, "Recommendation", "FastAPI", ":8000")
    Container(vision, "Vision", "FastAPI", ":8001")
    Container(rag, "RAG", "FastAPI", ":8002")
    Container(media, "Media Gen", "FastAPI", ":3456")
  }
  Deployment_Node(data_node, "data/", "fixtures") {
    Container(fixtures, "fixtures", "文件", "小文件入库；大权重 gitignore")
  }
  Deployment_Node(ui_node, "ui/", "规划") {
    Container(ui, "Model Test UI", "（未实现）", "与 python_ml 平级")
  }
}

Rel(rag, fixtures, "可选 path")
Rel(ui, rec, "HTTP", "规划")

SHOW_LEGEND()
@enduml
